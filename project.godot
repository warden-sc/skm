; Engine configuration file.
; Godot 4.3+ 에서 열어주세요.

config_version=5

[application]

config/name="Sefirah-like Topdown Action"
config/version="0.9.0"
config/description="세피리아 스타일 탑뷰 액션 게임 뼈대"
run/main_scene="res://scenes/title/title.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[audio]

driver/enable_input=true

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
Story="*res://scripts/autoload/story.gd"
Profile="*res://scripts/autoload/profile.gd"
SteamApi="*res://scripts/autoload/steam_api.gd"
Net="*res://scripts/autoload/net.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Achievements="*res://scripts/autoload/achievements.gd"
Admin="*res://scripts/autoload/admin.gd"
Chat="*res://scripts/autoload/chat.gd"
Bgm="*res://scripts/autoload/bgm.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/ui/game_theme.tres"

